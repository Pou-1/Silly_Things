  shipLeftAutomatically: 0
  openingDoorDialogue:
  - bodyText: 'Welcome to 41 Experimentation. '
    speakerText: PILOT COMPUTER
    waitTime: 3
  - bodyText: This moon appears to have been abandoned. You are likely to find no
      signs of life, so it will be an easy job.
    speakerText: PILOT COMPUTER
    waitTime: 7
  - bodyText: 'Your mission: to collect scrap worth monetary value.'
    speakerText: PILOT COMPUTER
    waitTime: 5
  - bodyText: As specified on your contract, you will recieve 20% of the earnings
      accrued by H.E. Global. As also specified, we are not responsible for injuries
      taken while on the job.
    speakerText: PILOT COMPUTER
    waitTime: 7
  gameOverDialogue:
  - bodyText: Warning! No response from crew, which has not returned. Emergency code
      activated.
    speakerText: PILOT COMPUTER
    waitTime: 5
  - bodyText: The autopilot will now attempt to fly to the closest safe spaceport.
      Your items have been lost.
    speakerText: PILOT COMPUTER
    waitTime: 5
  shipLeavingOnMidnightDialogue:
  - bodyText: Alert! The autopilot is leaving due to dangerous conditions.
    speakerText: PILOT COMPUTER
    waitTime: 6
  - bodyText: The Company must minimize risk of damage to proprietary hardware. Goodbye!
    speakerText: PILOT COMPUTER
    waitTime: 4
